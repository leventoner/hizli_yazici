<Window x:Class="YaziciCS.UI.VoiceRecordingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sesle Yaz" Width="400" Height="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True" WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="Window_MouseDown" Loaded="Window_Loaded" Closed="Window_Closed">

    <Window.Resources>
        <!-- Modern ScrollViewer Style -->
        <Style x:Key="DarkScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <ScrollContentPresenter />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Start Button Style -->
        <Style x:Key="StartButtonStyle" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#059669" Offset="0"/>
                        <GradientStop Color="#10B981" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="22" Padding="20,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stop Button Style -->
        <Style x:Key="StopButtonStyle" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#DC2626" Offset="0"/>
                        <GradientStop Color="#EF4444" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="22" Padding="20,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Glow & Card Container -->
    <Border Margin="12" CornerRadius="18" BorderThickness="1" BorderBrush="#334155">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0F172A" Offset="0"/>
                <GradientStop Color="#090D16" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.65" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>    <!-- Center Visualizer / Status / Controls -->
                <RowDefinition Height="Auto"/> <!-- Transcribed Text Box -->
                <RowDefinition Height="Auto"/> <!-- Footer Info -->
            </Grid.RowDefinitions>

            <!-- 1. Title Bar -->
            <Grid Grid.Row="0" Margin="16,14,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="8" Background="#1E293B" Margin="0,0,10,0">
                        <TextBlock Text="🎙️" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Sesle Yaz" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                    <Border Background="#1E293B" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Yüzen Menü" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                    </Border>
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="1" Click="BtnClose_Click" Cursor="Hand" Width="28" Height="28">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="cbdr" Background="Transparent" CornerRadius="8">
                                <TextBlock Text="✕" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="cbdr" Property="Background" Value="#334155"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- 2. Middle: Visualizer, Status & Action Button -->
            <StackPanel Grid.Row="1" Margin="20,12,20,10" VerticalAlignment="Center" HorizontalAlignment="Center">
                
                <!-- Status & Timer Display -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#94A3B8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStatus" Text="Kayıt için 'Başlat' düğmesine basın" 
                               FontSize="12" Foreground="#94A3B8" FontWeight="Medium" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="TxtTimer" Text="00:00" FontSize="32" FontWeight="Bold" 
                           Foreground="#FFFFFF" FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                <!-- Live Audio Frequency Bars Visualizer -->
                <Border Background="#090E17" CornerRadius="12" Padding="14,10" BorderThickness="1" BorderBrush="#1E293B" Margin="0,0,0,16">
                    <StackPanel x:Name="WaveformPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Height="42">
                        <!-- 20 Animated Frequency Bars -->
                        <Border Width="5" Height="6" CornerRadius="2.5" Background="#1E293B" Margin="2,0" VerticalAlignment="Center"/>
                        <Border Width="5" Height="8" CornerRadius="2.5" Background="#1E293B" Margin="2,0" VerticalAlignment="Center"/>
                        <Border Width="5" Height="10" CornerRadius="2.5" Background="#1E293B" Margin="2,0" VerticalAlignment="Center"/>
                        <Border Width="5" Height="12" CornerRadius="2.5" Background="#1E293B" Margin="2,0" VerticalAlignment="Center"/>
                        <Border Width="5" Height="14" CornerRadius="2.5" Background="#1E293B" Margin="2,0" VerticalAlignment="Center"/>
                        <Border Width="5" Height="16" CornerRadius="2.5" Background="#1E293B" Margin="2,0" VerticalAlignment="Center"/>
                        <Border Width="5" Height="18" CornerRadius="2.5" Background="#1E293B" Margin="2,0" VerticalAlignment="Center"/>
                        <Border Width="5" Height="20" CornerRadius="2.5" Background="#1E293B" Margin="2,0" VerticalAlignment="Center"/>
                        <Border Width="5" Height="22" CornerRadius="2.5" Background="#1E293B" Margin="2,0" VerticalAlignment="Center"/>
                        <Border Width="5" Height="24" CornerRadius="2.5" Background="#1E293B" Margin="2,0" VerticalAlignment="Center"/>
                        <Border Width="5" Height="24" CornerRadius="2.5" Background="#1E293B" Margin="2,0" VerticalAlignment="Center"/>
                        <Border Width="5" Height="22" CornerRadius="2.5" Background="#1E293B" Margin="2,0" VerticalAlignment="Center"/>
                        <Border Width="5" Height="20" CornerRadius="2.5" Background="#1E293B" Margin="2,0" VerticalAlignment="Center"/>
                        <Border Width="5" Height="18" CornerRadius="2.5" Background="#1E293B" Margin="2,0" VerticalAlignment="Center"/>
                        <Border Width="5" Height="16" CornerRadius="2.5" Background="#1E293B" Margin="2,0" VerticalAlignment="Center"/>
                        <Border Width="5" Height="14" CornerRadius="2.5" Background="#1E293B" Margin="2,0" VerticalAlignment="Center"/>
                        <Border Width="5" Height="12" CornerRadius="2.5" Background="#1E293B" Margin="2,0" VerticalAlignment="Center"/>
                        <Border Width="5" Height="10" CornerRadius="2.5" Background="#1E293B" Margin="2,0" VerticalAlignment="Center"/>
                        <Border Width="5" Height="8" CornerRadius="2.5" Background="#1E293B" Margin="2,0" VerticalAlignment="Center"/>
                        <Border Width="5" Height="6" CornerRadius="2.5" Background="#1E293B" Margin="2,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Action Controls: Start and Stop Buttons -->
                <Grid HorizontalAlignment="Center">
                    <!-- Start Button (visible when not recording) -->
                    <Button x:Name="BtnStart" Style="{StaticResource StartButtonStyle}" Click="BtnStart_Click" Visibility="Visible">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎙️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Kaydı Başlat" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Stop Button (visible when recording) -->
                    <Button x:Name="BtnStop" Style="{StaticResource StopButtonStyle}" Click="BtnStop_Click" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏹️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Durdur &amp; Metne Çevir" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- 3. Result / Transcript Box (Expands when text is available) -->
            <Border x:Name="ResultBorder" Grid.Row="2" Visibility="Collapsed" Margin="16,0,16,8"
                    Background="#0B132B" CornerRadius="12" BorderThickness="1" BorderBrush="#2563EB" Padding="12">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" Foreground="#10B981" FontWeight="Bold" Margin="0,0,5,0"/>
                            <TextBlock Text="Metne Çevrildi (Panoya Kopyalandı)" FontSize="11" FontWeight="SemiBold" Foreground="#10B981"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Click="BtnCopy_Click" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <TextBlock Text="📋 Tekrar Kopyala" FontSize="11" Foreground="#38BDF8"/>
                        </Button>
                    </Grid>
                    <TextBox x:Name="TxtResult" Text="" TextWrapping="Wrap" MaxHeight="70" IsReadOnly="True"
                             Background="Transparent" BorderThickness="0" Foreground="#F8FAFC" FontSize="12"
                             FontFamily="Segoe UI" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Border>

            <!-- 4. Footer Help Tip -->
            <Grid Grid.Row="3" Margin="16,0,16,12">
                <TextBlock Text="Durdurulduğunda metin otomatik panonuza aktarılır." 
                           FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
