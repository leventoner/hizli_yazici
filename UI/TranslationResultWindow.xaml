<Window x:Class="YaziciCS.UI.TranslationResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Çeviri Sonucu"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True" WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        MinWidth="440" MaxWidth="780" MinHeight="200" MaxHeight="560"
        Loaded="Window_Loaded" KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A3447"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3B4861"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E2638"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="MainBorder" CornerRadius="16" BorderThickness="1.5" Margin="12"
            Background="#121826" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#3B82F6" Offset="0"/>
                <GradientStop Color="#1E293B" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.7" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#182234" CornerRadius="14,14,0,0" Padding="16,12" BorderThickness="0,0,0,1" BorderBrush="#243046">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="LangBadge" CornerRadius="6" Padding="6,2" Margin="0,0,10,0" Background="#2563EB">
                            <TextBlock x:Name="TxtLang" Text="TR ➔ EN" FontWeight="Bold" FontSize="11" Foreground="White" FontFamily="Segoe UI"/>
                        </Border>
                        <TextBlock Text="Çeviri Sonucu" FontWeight="SemiBold" FontSize="14" Foreground="#E2E8F0" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnCopy" Style="{StaticResource ActionButtonStyle}" Click="BtnCopy_Click" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtCopyLabel" Text="Kopyala" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnClose" Style="{StaticResource ActionButtonStyle}" Width="32" Height="30" Padding="0" Click="BtnClose_Click" ToolTip="Kapat (ESC)">
                            <TextBlock Text="✕" FontSize="13" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Body: Selectable and Copyable Result Text -->
            <ScrollViewer Grid.Row="1" MaxHeight="400" VerticalScrollBarVisibility="Auto" Margin="16,14,16,10">
                <TextBox x:Name="TxtResult" IsReadOnly="True" TextWrapping="Wrap" 
                         Background="Transparent" Foreground="#F8FAFC" BorderThickness="0"
                         FontSize="14.5" LineHeight="24" FontFamily="Segoe UI"
                         SelectionBrush="#3B82F6" Cursor="IBeam" Focusable="True"
                         Text="Çevrilen metin buraya gelecek..."/>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#0F172A" CornerRadius="0,0,14,14" Padding="16,10" BorderThickness="0,1,0,0" BorderBrush="#1E293B">
                <Grid>
                    <TextBlock x:Name="TxtStats" Text="0 karakter • 0 kelime" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                    <TextBlock Text="Kapatmak için ESC tuşuna basın veya pencereyi sürükleyin" FontSize="11" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
