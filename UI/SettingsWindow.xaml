<Window x:Class="YaziciCS.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yazıcı - Ayarlar" Height="650" Width="450"
        Background="#121212" Foreground="White" WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0" Background="{Binding Current.ColorTheme}" Padding="20">
            <StackPanel>
                <TextBlock Text="⚙️ Uygulama Yapılandırması" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Kullanıcı deneyiminizi buradan kişiselleştirin" FontSize="12" Foreground="White" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <TextBlock Text="📱 Genel Görünüm" FontSize="16" FontWeight="Bold" Foreground="{Binding Current.ColorTheme}" Margin="0,10,0,5"/>
                <Rectangle Height="1" Fill="#333" Margin="0,0,0,10"/>
                
                <TextBlock Text="Uygulama Adı"/>
                <TextBox Text="{Binding Current.ProgramName, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,15" Background="#1e1e1e" Foreground="White" Padding="5"/>
                
                <TextBlock Text="Tema Rengi (Hex)"/>
                <TextBox Text="{Binding Current.ColorTheme, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,15" Background="#1e1e1e" Foreground="White" Padding="5"/>
                
                <TextBlock Text="⌨️ Kısayollar" FontSize="16" FontWeight="Bold" Foreground="{Binding Current.ColorTheme}" Margin="0,10,0,5"/>
                <Rectangle Height="1" Fill="#333" Margin="0,0,0,10"/>
                
                <TextBlock Text="Metin İşlem Kısayolu (örn: ctrl+c)"/>
                <TextBox Text="{Binding Current.Hotkey, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,15" Background="#1e1e1e" Foreground="White" Padding="5"/>
                
                <TextBlock Text="Sesle Yazma Kısayolu (örn: ctrl+shift+y)"/>
                <TextBox Text="{Binding Current.SttHotkey, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,15" Background="#1e1e1e" Foreground="White" Padding="5"/>
                
                <TextBlock Text="⚙️ Özellikler" FontSize="16" FontWeight="Bold" Foreground="{Binding Current.ColorTheme}" Margin="0,10,0,5"/>
                <Rectangle Height="1" Fill="#333" Margin="0,0,0,10"/>
                
                <CheckBox Content="Karakter Düzeltme Aktif" IsChecked="{Binding Current.EnableCharacterFix, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10" Foreground="White"/>
                <CheckBox Content="AI İyileştirme Aktif" IsChecked="{Binding Current.EnableAiImprove, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10" Foreground="White"/>
                <CheckBox Content="Sesle Yazma Aktif" IsChecked="{Binding Current.EnableSpeechToText, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10" Foreground="White"/>
                <CheckBox Content="Değişiklik Olmazsa Uyarı Ver" IsChecked="{Binding Current.NotifyOnNoChange, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10" Foreground="White"/>

                <TextBlock Text="🌐 Çeviri Sağlayıcısı" FontSize="16" FontWeight="Bold" Foreground="{Binding Current.ColorTheme}" Margin="0,10,0,5"/>
                <Rectangle Height="1" Fill="#333" Margin="0,0,0,10"/>

                <TextBlock Text="Sağlayıcı"/>
                <ComboBox SelectedValue="{Binding Current.TranslationProvider, UpdateSourceTrigger=PropertyChanged}"
                          SelectedValuePath="Tag" Margin="0,5,0,5" Background="#1e1e1e" Foreground="White">
                    <ComboBoxItem Content="Ücretsiz (API anahtarsız - Google/MyMemory)" Tag="free"/>
                    <ComboBoxItem Content="Gemini (API anahtarı gerekir)" Tag="gemini"/>
                </ComboBox>
                <TextBlock Text="Not: Ücretsiz modda internet gerekir; Google anahtarsız servisi kullanılır, başarısız olursa MyMemory yedeği devreye girer."
                           FontSize="11" Foreground="#9e9e9e" TextWrapping="Wrap" Margin="0,0,0,10"/>

                <TextBlock Text="MyMemory E-postası (isteğe bağlı)"/>
                <TextBox Text="{Binding Current.TranslationEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,5" Background="#1e1e1e" Foreground="White" Padding="5"/>
                <TextBlock Text="E-posta girilirse MyMemory ücretsiz günlük limiti 5.000'den 50.000 karaktere çıkar."
                           FontSize="11" Foreground="#9e9e9e" TextWrapping="Wrap" Margin="0,0,0,10"/>

                <TextBlock Text="🎙️ Sesle Yazma (Speech-to-Text)" FontSize="16" FontWeight="Bold" Foreground="{Binding Current.ColorTheme}" Margin="0,10,0,5"/>
                <Rectangle Height="1" Fill="#333" Margin="0,0,0,10"/>

                <TextBlock Text="Maksimum Kayıt Süresi (Saniye)"/>
                <TextBox Text="{Binding Current.SttDuration, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10" Background="#1e1e1e" Foreground="White" Padding="5"/>

                <TextBlock Text="Ses Tanıma Motoru"/>
                <ComboBox SelectedValue="{Binding Current.SttProvider, UpdateSourceTrigger=PropertyChanged}"
                          SelectedValuePath="Tag" Margin="0,5,0,5" Background="#1e1e1e" Foreground="White">
                    <ComboBoxItem Content="Lokal AI - Whisper (Tamamen Çevrimdışı, Kota Yok)" Tag="local"/>
                    <ComboBoxItem Content="Gemini AI (Bulut, API Anahtarı Gerekir)" Tag="gemini"/>
                </ComboBox>
                <TextBlock Text="Öneri: 'Lokal AI - Whisper' bilgisayarınızda tamamen yerel çalışır, internet ve API kotası gerektirmez."
                           FontSize="11" Foreground="#9e9e9e" TextWrapping="Wrap" Margin="0,0,0,10"/>
            </StackPanel>
        </ScrollViewer>
        
        <Border Grid.Row="2" Background="#1e1e1e" Padding="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="İptal" Width="100" Padding="8" Margin="0,0,10,0" Background="#424242" Foreground="White" BorderThickness="0" Click="BtnCancel_Click"/>
                <Button Content="Kaydet" Width="120" Padding="8" Background="{Binding Current.ColorTheme}" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnSave_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
