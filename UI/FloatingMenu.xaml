<Window x:Class="YaziciCS.UI.FloatingMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FloatingMenu" Height="48" Width="228"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="True"
        Opacity="0" Loaded="Window_Loaded">
    
    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3fffffff"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#5fffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Border CornerRadius="10" BorderThickness="1" Padding="6,4">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{Binding ThemeColor.Color}" Offset="0"/>
                <GradientStop Color="#40ffffff" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#2c3e50" Offset="0"/>
                <GradientStop Color="#1e272e" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Karakter Düzelt (Pencil / Edit) -->
            <Button x:Name="BtnFix" Style="{StaticResource MenuButtonStyle}" ToolTip="Karakter Düzelt (ç, ğ, ı, ö, ş, ü)" Click="BtnFix_Click">
                <Viewbox Width="17" Height="17">
                    <Canvas Width="24" Height="24">
                        <Path Data="M17 3a2.85 2.85 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z M15 5l4 4" 
                              Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Canvas>
                </Viewbox>
            </Button>

            <!-- Metni İyileştir (Metin Sihirbazı) -->
            <Button x:Name="BtnImprove" Style="{StaticResource MenuButtonStyle}" ToolTip="Metin Sihirbazı (Düzelt ve İyileştir)" Click="BtnImprove_Click">
                <Viewbox Width="18" Height="18">
                    <Canvas Width="24" Height="24">
                        <Path Data="m21.64 3.64-1.28-1.28a1.21 1.21 0 0 0-1.72 0L2.36 18.64a1.21 1.21 0 0 0 0 1.72l1.28 1.28a1.2 1.2 0 0 0 1.72 0L21.64 5.36a1.2 1.2 0 0 0 0-1.72Z M14 7l3 3"
                              Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        <Path Data="M5 6v4 M7 8H3 M19 14v4 M21 16h-4 M10 2v2 M11 3H9"
                              Stroke="#FBBF24" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                </Viewbox>
            </Button>

            <!-- Çevir EN (Türkçe ↔ İngilizce) -->
            <Button x:Name="BtnTranslate" Style="{StaticResource MenuButtonStyle}" ToolTip="Çevir (Türkçe ↔ İngilizce)" Click="BtnTranslate_Click">
                <Grid Width="24" Height="24">
                    <Canvas Width="17" Height="17" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Ellipse Canvas.Left="0.5" Canvas.Top="0.5" Width="16" Height="16" 
                                 Stroke="White" StrokeThickness="1.6"/>
                        <Path Data="M8.5 0.5a11.5 11.5 0 0 0 0 16 11.5 11.5 0 0 0 0-16" 
                               Stroke="White" StrokeThickness="1.6"/>
                        <Line X1="0.5" Y1="8.5" X2="16.5" Y2="8.5" 
                               Stroke="White" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Background="#2563EB" CornerRadius="2.5" Padding="2,0.5">
                        <TextBlock Text="EN" FontSize="7.5" FontWeight="Bold" Foreground="White" 
                                   FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display"/>
                    </Border>
                </Grid>
            </Button>

            <!-- Çevir FR (Türkçe ↔ Fransızca) -->
            <Button x:Name="BtnTranslateFr" Style="{StaticResource MenuButtonStyle}" ToolTip="Çevir (Türkçe ↔ Fransızca)" Click="BtnTranslateFr_Click">
                <Grid Width="24" Height="24">
                    <Canvas Width="17" Height="17" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Ellipse Canvas.Left="0.5" Canvas.Top="0.5" Width="16" Height="16" 
                                 Stroke="White" StrokeThickness="1.6"/>
                        <Path Data="M8.5 0.5a11.5 11.5 0 0 0 0 16 11.5 11.5 0 0 0 0-16" 
                               Stroke="White" StrokeThickness="1.6"/>
                        <Line X1="0.5" Y1="8.5" X2="16.5" Y2="8.5" 
                               Stroke="White" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Background="#DC2626" CornerRadius="2.5" Padding="2,0.5">
                        <TextBlock Text="FR" FontSize="7.5" FontWeight="Bold" Foreground="White" 
                                   FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display"/>
                    </Border>
                </Grid>
            </Button>

            <!-- Sesle Yaz (Mikrofon) -->
            <Button x:Name="BtnVoice" Style="{StaticResource MenuButtonStyle}" ToolTip="Sesle Yaz (Ctrl+Shift+Y)" Click="BtnVoice_Click">
                <Viewbox Width="17" Height="17">
                    <Canvas Width="24" Height="24">
                        <Path Data="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z" 
                              Stroke="White" StrokeThickness="1.8" Fill="#e74c3c"/>
                        <Path Data="M19 10v2a7 7 0 0 1-14 0v-2 M12 19v3 M8 22h8" 
                              Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                </Viewbox>
            </Button>
        </StackPanel>
    </Border>
</Window>
